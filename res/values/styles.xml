<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Steampunk Color Palette & Theme -->
    <style name="Theme.SteampunkRadio" parent="Theme.MaterialComponents.DayNight.DarkActionBar">
        <!-- Main background: Dark Leather / Old Wood -->
        <item name="android:windowBackground">#3D2B1F</item>
        <!-- Primary Accent: Antique Brass -->
        <item name="colorPrimary">#C39B78</item>
        <item name="colorPrimaryVariant">#A67C52</item>
        <!-- Secondary Accent: Aged Copper -->
        <item name="colorSecondary">#B87333</item>
        <!-- Text color: Aged Parchment -->
        <item name="android:textColorPrimary">#E0C9A6</item>
        <!-- Button theme -->
        <item name="materialButtonStyle">@style/Widget.Steampunk.Button</item>
    </style>

    <style name="Widget.Steampunk.Button" parent="Widget.MaterialComponents.Button">
        <item name="backgroundTint">#C39B78</item>
        <item name="android:textColor">#3D2B1F</item>
        <item name="cornerRadius">4dp</item>
        <item name="android:textStyle">bold</item>
    </style>
</resources>
